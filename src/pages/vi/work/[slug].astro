---
import { getCollection } from 'astro:content';
import DetailPage from '../../../components/DetailPage.astro';
import MetroPage from '../../../components/metro/MetroPage.astro';
export async function getStaticPaths() {
  return (
    await getCollection('work', ({ data }) => data.lang === 'vi' && !data.draft)
  ).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
---

{entry.data.kind === 'consulting' ? (
  <MetroPage
    lang="vi"
    kind="project"
    slug={entry.data.slug === 'hncc' ? 'hanoicc' : entry.data.slug}
  />
) : (
  <DetailPage lang="vi" entry={entry} />
)}
