---
import { site, profile } from '../data/profile';
import { equivalent, type Lang } from '../i18n';
interface Props {
  title: string;
  description: string;
  lang: Lang;
  path: string;
  noindex?: boolean;
}
const { title, description, lang, path, noindex = false } = Astro.props;
const canonical = new URL(path, site).href;
const og = new URL(`/og/${path.replace(/^\/|\/$/g, '') || 'home'}.png`, site)
  .href;
---

<title>{title} | {profile.person.displayName}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link
  rel="alternate"
  hreflang="en"
  href={new URL(equivalent(path, 'en'), site).href}
/>
<link
  rel="alternate"
  hreflang="vi"
  href={new URL(equivalent(path, 'vi'), site).href}
/>
<link
  rel="alternate"
  hreflang="x-default"
  href={new URL(equivalent(path, 'en'), site).href}
/>
{noindex && <meta name="robots" content="noindex,follow" />}
<meta
  property="og:title"
  content={`${title} | ${profile.person.displayName}`}
/>
<meta property="og:description" content={description} />
<meta
  property="og:type"
  content={
    path.includes('/work/') &&
    path.split('/').filter(Boolean).length > (lang === 'vi' ? 2 : 1)
      ? 'article'
      : 'website'
  }
/>
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
<meta property="og:image" content={og} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${title} · Tuan Do`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og} />
