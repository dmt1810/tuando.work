---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import ServiceCard from './ServiceCard.astro';
import CaseCard from './CaseCard.astro';
import LabCard from './LabCard.astro';
import Contact from './Contact.astro';
import Office from './office/Office.astro';
import { entries } from '../data/content';
import { profile } from '../data/profile';
import { strings, url, type Lang } from '../i18n';
import { Image } from 'astro:assets';
import photo from '../../public/tuan-profile.jpg';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props,
  t = strings(lang);
const [services, work, lab] = await Promise.all([
  entries('services', lang),
  entries('work', lang),
  entries('lab', lang),
]);
---

<Base
  lang={lang}
  title={profile.person.headline[lang]}
  description={profile.person.subline[lang]}
>
  <div class="wrap">
    <Hero lang={lang} />
    <Office lang={lang} />
    <section class="section">
      <div class="section-head">
        <div>
          <p class="eyebrow">01 / {t.services}</p>
          <h2>{t.servicesTitle}</h2>
          <p>{t.servicesIntro}</p>
        </div>
      </div>
      <div class="card-grid">
        {services.map((entry) => (
          <ServiceCard entry={entry} lang={lang} />
        ))}
      </div>
    </section>
    <section class="section">
      <div class="section-head">
        <div>
          <p class="eyebrow">02 / {t.work}</p>
          <h2>{t.workTitle}</h2>
          <p>{t.workIntro}</p>
        </div>
        <a class="text-link" href={url(lang, 'work')}>
          {t.allWork}
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </div>
      <div class="card-grid">
        {work
          .filter((e) => 'selected' in e.data && e.data.selected)
          .sort(
            (a, b) =>
              ['igloo', 'onemount', 'catsa'].indexOf(a.data.slug) -
              ['igloo', 'onemount', 'catsa'].indexOf(b.data.slug),
          )
          .slice(0, 3)
          .map((entry) => (
            <CaseCard entry={entry} lang={lang} />
          ))}
      </div>
    </section>
    <section class="section">
      <div class="section-head">
        <div>
          <p class="eyebrow">03 / {t.lab}</p>
          <h2>{t.labTitle}</h2>
          <p>{t.labIntro}</p>
        </div>
        <a class="text-link" href={url(lang, 'lab')}>
          {lang === 'vi' ? 'Ghé Lab' : 'Visit the lab'}
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </div>
      {lab.length ? (
        <div class="card-grid">
          {lab.slice(0, 3).map((entry) => (
            <LabCard entry={entry} lang={lang} />
          ))}
        </div>
      ) : (
        <div class="lab-empty">
          <span class="mono">[ {t.labEmpty} ]</span>
          <p>{t.labEmptyText}</p>
        </div>
      )}
    </section>
    <section class="section about-grid">
      <Image
        src={photo}
        alt={profile.person.name}
        width={220}
        height={266}
        format="webp"
        loading="lazy"
        class="about-photo"
      />
      <div class="about-text">
        <p class="eyebrow">{lang === 'vi' ? 'Về Tuấn' : 'Meet Tuan'}</p>
        <h2>{t.about}</h2>
        <p>{t.aboutText}</p>
        <a href={url(lang, 'cv')} class="text-link">
          {lang === 'vi' ? 'Xem hồ sơ nghề nghiệp' : 'Explore my experience'}
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </div>
    </section>
    <Contact lang={lang} />
  </div>
</Base>
