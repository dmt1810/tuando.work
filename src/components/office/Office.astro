---
import './scene.css';
import { sprite } from './sprites';
import { workstation } from './workstation';
import { workflow } from './workflow';
import { profile } from '../../data/profile';
import { strings, url, type Lang } from '../../i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props,
  t = strings(lang),
  steps = workflow(lang),
  agents = profile.officeAgents.map((a) => ({
    ...a,
    link: a.external ? a.link : url(lang, a.link),
  }));
---

<section
  class="office"
  aria-labelledby="office-title"
  data-office
  data-office-playing="false"
  data-lang={lang}
>
  <header class="office-heading">
    <div>
      <h2 id="office-title">{t.office}</h2>
      <p>{t.officeIntro}</p>
    </div>
    <div class="office-controls">
      <span class="office-status mono">
        {lang === 'vi' ? 'WORKFLOW MINH HỌA' : 'ILLUSTRATIVE WORKFLOW'}
      </span>
      <button
        class="office-toggle"
        data-office-toggle
        type="button"
        aria-pressed="false"
        hidden
      >
        {lang === 'vi' ? 'Tạm dừng' : 'Pause motion'}
      </button>
    </div>
  </header>
  <div class="office-scene">
    <div class="office-room" aria-hidden="true"></div>
    <span data-office-config={JSON.stringify(agents)} hidden></span>
    <span data-workflow-config={JSON.stringify(steps)} hidden></span>
    {agents.map((agent) =>
      agent.external ? (
        <a
          class={`office-agent ${agent.id}`}
          data-agent={agent.id}
          href={agent.link}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${agent.title}: ${agent.big}`}
        >
          <span class="station-art" set:html={workstation(true)} />
          <span class="sprite" set:html={sprite(agent.id)} />
          <span class="agent-name">{agent.label}</span>
        </a>
      ) : (
        <button
          class={`office-agent ${agent.id}`}
          data-agent={agent.id}
          type="button"
          disabled
          aria-label={`${agent.title}: ${agent.big}. ${agent.caption}`}
          aria-expanded="false"
          aria-controls="office-bubble"
        >
          <span class="station-art" set:html={workstation()} />
          <span class="sprite" set:html={sprite(agent.id)} />
          <span class="agent-name">{agent.label}</span>
        </button>
      ),
    )}
    <div class="office-bubble" id="office-bubble" aria-live="off" hidden>
      <p class="bubble-big"></p>
      <p class="bubble-caption"></p>
      <div class="bubble-detail" hidden>
        <p data-role></p>
        <a href={url(lang, 'services')}>
          {t.learn}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <span class="brief" aria-hidden="true" hidden>
      brief
    </span>
  </div>
  <div class="office-hint mono">
    <span>{t.officeHint}</span>
    <span>
      {lang === 'vi'
        ? 'BRIEF → LEAD → PHẢN HỒI ↺'
        : 'BRIEF → LEAD → FEEDBACK ↺'}
    </span>
  </div>
  <div
    class="workflow"
    aria-label={
      lang === 'vi'
        ? 'Từ chiến dịch tới quyết định'
        : 'From campaign to decision'
    }
  >
    <div class="workflow-heading">
      <p class="eyebrow">
        {lang === 'vi' ? 'Hệ thống hoạt động thế nào' : 'The system, in motion'}
      </p>
      <p>
        {lang === 'vi'
          ? 'Ví dụ: từ nhu cầu tư vấn đến lead phù hợp, rồi đến quyết định tiếp theo.'
          : 'Example: a service enquiry becomes a qualified lead, then a better decision.'}
      </p>
    </div>
    <ol class="workflow-steps">
      {steps.map((step, index) => (
        <li>
          <button
            type="button"
            data-workflow-step={index}
            aria-pressed={index === 0 ? 'true' : 'false'}
            disabled
          >
            <span class="mono">0{index + 1}</span>
            {step.label}
            <span aria-hidden="true">
              {index === steps.length - 1 ? '↺' : '→'}
            </span>
          </button>
        </li>
      ))}
    </ol>
    <div class="workflow-detail" data-workflow-detail>
      <div class="workflow-story">
        <p class="workflow-handoff mono" data-workflow-handoff>
          Manager → Creative + Performance
        </p>
        <h3 data-workflow-title>{steps[0].title}</h3>
        <p data-workflow-next>{steps[0].next}</p>
      </div>
      <dl class="workflow-artifact">
        <div>
          <dt>{lang === 'vi' ? 'Đầu vào' : 'Input'}</dt>
          <dd data-workflow-input>{steps[0].input}</dd>
        </div>
        <div>
          <dt>{lang === 'vi' ? 'Đầu ra' : 'Output'}</dt>
          <dd data-workflow-output>{steps[0].output}</dd>
        </div>
      </dl>
    </div>
    <noscript>
      <ol class="workflow-static">
        {steps.slice(1).map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.input}</p>
            <p>{step.output}</p>
            <p>{step.next}</p>
          </li>
        ))}
      </ol>
    </noscript>
  </div>
  <ul class="office-fallback">
    {agents.map((agent) => (
      <li>
        <strong>{agent.title}</strong>
        <p>{agent.role}</p>
        <p>
          {agent.big} · {agent.caption}
        </p>
        <a
          href={agent.link}
          target={agent.external ? '_blank' : undefined}
          rel={agent.external ? 'noopener noreferrer' : undefined}
        >
          {t.learn} ↗
        </a>
      </li>
    ))}
  </ul>
</section>
<script>
  const office = document.querySelector<HTMLElement>('[data-office]');
  if (office) {
    const observer = new IntersectionObserver(
      (items) => {
        if (!items[0].isIntersecting) return;
        const connection = (
          navigator as Navigator & { connection?: { saveData?: boolean } }
        ).connection;
        if (connection?.saveData) return;
        observer.disconnect();
        const ready = () => {
          const load = () =>
            import('./office').then((module) => module.startOffice(office));
          if ('requestIdleCallback' in window)
            window.requestIdleCallback(load, { timeout: 1500 });
          else setTimeout(load, 0);
        };
        if (document.readyState === 'complete') ready();
        else window.addEventListener('load', ready, { once: true });
      },
      { rootMargin: '100px' },
    );
    observer.observe(office);
  }
</script>
